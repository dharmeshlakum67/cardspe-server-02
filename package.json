{
	"name": "cardspe_react",
	"version": "4.3.2",
	"private": true,
	"scripts": {
		"start": "react-scripts start",
		"build": "react-scripts build",
		"serve": "serve -s build",
		"test": "react-scripts test",
		"eject": "react-scripts eject",
		"lint": "eslint .",
		"lint:fix": "eslint --fix --ext .js --ext .ts --ext .jsx --ext .tsx ./src",
		"lint:scss": "stylelint **/*.scss",
		"lint:fix-scss": "stylelint --fix **/*.scss",
		"icon": "svgr SvgIcons -d src/components/icon/svg-icons --typescript"
	},
	"jest": {
		"transformIgnorePatterns": [
			"<rootDir>/node_modules/(?!pascalcase|@omtanke/react-use-event-outside/.*)"
		]
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		],
		"rules": {
			"jsx-a11y/control-has-associated-label": "off"
		}
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 4 version",
			">0.2%"
		]
	},
